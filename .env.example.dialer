# Telnyx dialer — Phase 11
# Source spec: docs/specs/combo-prospection-autonome.md
# Dev-ready spec: docs/specs/lot-11.1-telnyx-infra.md

# ── Environment selector (dev / prod / dryrun) ────────────────────────────
# 'dryrun' = no network calls, returns fixture responses. Use in CI/dev.
# 'dev'    = calls Telnyx dev account (requires TELNYX_API_KEY_DEV)
# 'prod'   = calls Telnyx prod account (requires TELNYX_API_KEY_PROD)
TELNYX_ENV=dev

# ── Telnyx API keys (NEVER COMMIT real values) ─────────────────────────────
# Dev account
TELNYX_API_KEY_DEV=KEY_DEV_REPLACE_ME
TELNYX_CALLER_ID_DEV=+33XXXXXXXXX
# Prod account
TELNYX_API_KEY_PROD=KEY_PROD_REPLACE_ME
TELNYX_CALLER_ID_PROD=+33XXXXXXXXX

# ── Webhook signature verification (Ed25519) ───────────────────────────────
# Required for non-dryrun environments. Telnyx dashboard exposes this in
# Account Settings → Webhooks → Public Key. Format: base64:xxx
WEBHOOK_TELNYX_PUBLIC_KEY=base64:REPLACE_ME
# Tolerance window for replay protection (seconds, default 300)
WEBHOOK_TELNYX_TOLERANCE_SEC=300

# ── Budget caps (in cents, overridable via settings table) ──────────────────
# Per-session cap (default 3€/session = 300 cents)
DIALER_BUDGET_SESSION_CENTS=300
# Per-user-per-day cap (default 10€/day = 1000 cents)
DIALER_BUDGET_USER_DAY_CENTS=1000
# Per-org-per-month cap (default 150€/month = 15000 cents)
DIALER_BUDGET_ORG_MONTH_CENTS=15000

# ── Rate limit (defense in depth vs Telnyx 100/s limit) ────────────────────
# Sustained RPS (default 5)
DIALER_RATE_RPS=5
# Burst capacity (default 20)
DIALER_RATE_BURST=20

# ── Misc ───────────────────────────────────────────────────────────────────
# Supabase service role key for dialer/* endpoints (already required by
# other api/* handlers — listed here for completeness).
SUPABASE_SERVICE_ROLE_KEY=existing_in_env
# Vercel cron secret for the 5min webhook reconciliation job (11.2)
CRON_SECRET=existing_in_env